[Unit]
Description=Long Range Node Attack on port 2001
After=network-online.target
Wants=network-online.target

[Service]
User=nixon
WorkingDirectory=/home/nixon/longrange
ExecStart=/usr/bin/python3 -m http.server 2001 --bind 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
